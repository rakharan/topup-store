# Server
PORT=8080
REQUEST_TIMEOUT=30s

# Database
DATABASE_URL=postgres://topup:topup@localhost:5432/topup_store?sslmode=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m

# Migrations (auto-run on startup for local dev)
AUTO_MIGRATE=true

# Midtrans (payments)
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# Digiflazz (top-up supplier)
DIGIFLAZZ_USERNAME=your_username
DIGIFLAZZ_API_KEY=your_api_key
DIGIFLAZZ_WEBHOOK_SECRET=topup store df wh 2024
DIGIFLAZZ_API_URL=https://api.digiflazz.com/v1/transaction
DIGIFLAZZ_TESTING=true

# Fonnte (WhatsApp messaging)
FONNTE_TOKEN=your_fonnte_token

# Admin
ADMIN_PASSWORD=changeme
ADMIN_PATH=/admin

# WhatsApp Bot Sidecar (deprecated, fallback only)
WA_BOT_BASE_URL=http://localhost:3001
WA_BOT_TOKEN=your_shared_bot_token

# WhatsApp Bot Notify Token (shared secret for /notify endpoint)
BOT_NOTIFY_TOKEN=your_shared_bot_token
